# Groq Chat Completions API: https://api.groq.com/openai/v1/chat/completions
# Create a key in Groq Console; keep it only in .env.local.
GROQ_API_KEY=
# Optional model id (production model by default)
GROQ_MODEL=openai/gpt-oss-120b

# Force deterministic mock replies (no network). Also used automatically
# when the key is missing or the API request fails.
LLM_MOCK=1

# Neon / Postgres connection string (Vercel Neon integration sets this).
# When empty, stores fall back to local data/*.json files.
# Pull from Vercel: npx vercel env pull .env.local
DATABASE_URL=
